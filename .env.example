# 百炼 DashScope API Key。不要提交真实密钥。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.6-plus
QWEN_FAST_MODEL=qwen3.6-flash
# 成长陪伴 Agent 的三档候选池；服务端从空闲模型中随机选择。
QWEN_FAST_MODELS=qwen3-8b,qwen3-14b,qwen-flash,qwen-flash-2025-07-28,qwen3.6-flash,qwen3.5-flash,qwen3.6-flash-2026-04-16,qwen3.7-flash,qwen3.8-flash
QWEN_BALANCED_MODELS=qwen3.5-27b,qwen3.6-27b,qwen3.8-27b,qwen3.6-plus,qwen3.7-plus,qwen3.5-plus-2026-04-20,qwen-plus-1220,qwen3.5-plus-2026-02-15,qwen-plus-latest,qwen-plus-2025-09-11,qwen3.7-plus-2026-05-26,qwen-plus-2025-01-25,qwen-plus-2025-04-28,qwen3.5-plus,qwen-plus-2025-07-14,qwen3.6-plus-2026-04-02
QWEN_REASONING_MODELS=qwen-max,qwen3-max,qwen3-max-2026-01-23,qwen3.7-max,qwen3.7-max-2026-06-08,qwen3.7-max-preview,qwen3.7-max-2026-05-17,qwen3.8-max
# 四组 TrialAgent 对照中的基线和 SFT 模型；SFT 模型训练并部署后再填写
TRIAL_BASE_MODEL=qwen-plus
TRIAL_SFT_MODEL=
TRIAL_VERIFIER_MODEL=
TRIAL_TEACHER_MODEL=qwen3-vl-plus
TRIAL_REVIEW_MODEL=qwen3-vl-235b-a22b-instruct
TRIAL_TEACHER_PROMPT_VERSION=trial-teacher-v1
TRIAL_TEACHER_CACHE_PATH=datasets/trial_agent/v1/teacher_cache.sqlite3
TRIAL_VERIFIER_MIN_EVIDENCE_COVERAGE=0.75
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 留空时从 DASHSCOPE_BASE_URL 的工作空间 Host 自动推导
BAILIAN_EMBEDDING_URL=
BAILIAN_EMBEDDING_MODEL=qwen3.7-text-embedding
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_EMBEDDING_BATCH_SIZE=20
BAILIAN_RERANK_URL=
BAILIAN_RERANK_MODEL=qwen3-rerank
BAILIAN_VISION_MODEL=qwen-vl-ocr
# OCR 与多模态分池；OCR 专用模型不会接收 System Message。
OCR_FAST_MODELS=qwen3-vl-flash-2026-01-22
OCR_SPECIALIST_MODELS=qwen3.5-ocr,qwen-vl-ocr-2025-11-20
VISION_GENERAL_MODELS=qwen3-vl-plus,qwen3-vl-32b-instruct,qwen3-vl-235b-a22b-instruct
VISION_REASONING_MODELS=qwen3-vl-235b-a22b-thinking
MULTIMODAL_MAX_PAGES=8
# The expanded 84-query benchmark uses semantic vector retrieval by default.
# Use adaptive for low-confidence rerank routing or hybrid for the fixed
# FTS5 + vector fusion + rerank comparison path.
RAG_RETRIEVER_MODE=vector
RAG_CANDIDATE_LIMIT=20
RAG_RERANK_LIMIT=5
# RRF/MMR defaults tuned on scripts/rag_eval_cases_v3.json
RAG_RRF_K=20
RAG_RRF_ANCHOR_LEXICAL_WEIGHT=0
RAG_MMR_RELEVANCE_WEIGHT=0.65
RAG_ADAPTIVE_MARGIN=0.055
RAG_ADAPTIVE_RERANK_MIN_MARGIN=0.02
# qwen3.6-plus structured proposals can take around 90s; keep upstream headroom.
LLM_REQUEST_TIMEOUT=180
# 所有百炼聊天、视觉、Embedding 和 Rerank 请求共用 FIFO 队列。
LLM_MAX_CONCURRENCY=5
# 单个模型默认只执行一个请求；同池其他空闲模型可并行工作。
LLM_MODEL_MAX_CONCURRENCY=1
LLM_MODEL_FAILURE_THRESHOLD=2
LLM_MODEL_COOLDOWN_SECONDS=60
LLM_MAX_REQUESTS_PER_MINUTE=30
PROFILE_DB_PATH=profile.db
# 登录会话有效期，单位为小时；仅用于本机正式模式
AUTH_SESSION_TTL_HOURS=720
# Password reset codes are single-use and expire after 10 minutes.
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_FROM=
KNOWLEDGE_DIR=knowledge/public
KNOWLEDGE_DB_PATH=knowledge.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
