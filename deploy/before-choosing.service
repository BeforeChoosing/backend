[Unit]
Description=Before Choosing API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=before-choosing
Group=before-choosing
WorkingDirectory=/opt/before-choosing/current/backend
EnvironmentFile=/etc/before-choosing/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/before-choosing-venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/before-choosing
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
