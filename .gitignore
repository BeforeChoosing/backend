build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -----------------------------
# Jupyter
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# IDE / editor settings
# -----------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

